# Copy to /etc/manokara/manokara.env, edit it, and chmod 600.
MANOKARA_ORIGIN=https://karaoke.example.com
# Generate interactively: /opt/manokara/.venv/bin/python /opt/manokara/outputs/manokara_server.py hash-password
MANOKARA_PASSWORD_HASH=replace-with-generated-scrypt-hash
MANOKARA_DATA_DIR=/var/lib/manokara
